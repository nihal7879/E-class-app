# Copy this file to .env and fill in real values.
# Do NOT commit .env (it's gitignored).

# --- MySQL connection ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=eclass_analytics

# --- Server ---
PORT=4000

# --- CORS ---
# Comma-separated list of allowed origins. Use * for any origin (dev only).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Senior sir's API (Flow 1) ---
# Leave blank until the API spec is ready. The Excel fallback (Flow 2) does not need these.
SENIOR_API_URL=
SENIOR_API_TOKEN=
